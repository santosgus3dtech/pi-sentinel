PISENTINEL_DB_PATH=/var/lib/pi-sentinel/pisentinel.db
PISENTINEL_LABEL=Lab-Network
PISENTINEL_CIDR=192.168.10.0/24
PISENTINEL_INTERFACE=wlan0
PISENTINEL_SSIDS=Lab-Network,Lab-Network-5G
PISENTINEL_INTERVAL_SECONDS=30
PISENTINEL_DISCOVERY_INTERVAL_SECONDS=300
PISENTINEL_RETENTION_DAYS=30
PISENTINEL_INCIDENT_RETENTION_DAYS=90
PISENTINEL_FAILURE_THRESHOLD=3
PISENTINEL_RECOVERY_THRESHOLD=2
PISENTINEL_STALE_AFTER_SECONDS=120
PISENTINEL_MAX_HOSTS=1024
PISENTINEL_MOCK_PRINTER_ENABLED=true
PISENTINEL_PRINTER_CONTROLS_ENABLED=false
PISENTINEL_SPEEDTEST_EXECUTABLE=/usr/bin/speedtest
PISENTINEL_SPEEDTEST_TIMEOUT_SECONDS=180
PISENTINEL_SPEEDTEST_POLL_SECONDS=15
PISENTINEL_AUTH_ENABLED=true
PISENTINEL_AUTH_SESSION_HOURS=12
PISENTINEL_AUTH_REMEMBER_DAYS=30
PISENTINEL_ROUTER_HOST=192.168.10.1
PISENTINEL_ROUTER_USERNAME=
PISENTINEL_ROUTER_PASSWORD=
PISENTINEL_ROUTER_POLL_SECONDS=30
PISENTINEL_ROUTER_LOG_POLL_SECONDS=300
BAMBU_A1_HOST=
BAMBU_A1_SERIAL=
BAMBU_A1_ACCESS_CODE=
BAMBU_A1_CERT_SHA256=
PYTHONDONTWRITEBYTECODE=1
