[Unit]
Description=PiSentinel network discovery and probe collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pisentinel
Group=pisentinel
SupplementaryGroups=netdev
WorkingDirectory=/opt/pi-sentinel
EnvironmentFile=/etc/pi-sentinel/pisentinel.env
ExecStart=/opt/pi-sentinel/.venv/bin/python -m pisentinel.collector
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pi-sentinel
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK

[Install]
WantedBy=multi-user.target
