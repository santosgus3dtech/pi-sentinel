[Unit]
Description=PiSentinel Ookla speed test worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pisentinel
Group=pisentinel
WorkingDirectory=/opt/pi-sentinel
EnvironmentFile=/etc/pi-sentinel/pisentinel.env
ExecStart=/opt/pi-sentinel/.venv/bin/python -m pisentinel.speedtest_worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pi-sentinel
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
